{
  "name": "dsh-work-crew",
  "version": "0.4.0",
  "description": "DSH 插件：把任务派给本机的豆包 / WorkBuddy / ZCode / Qoder，用任务板与产物锁组织一支有纪律的 AI 班组。",
  "type": "module",
  "license": "MIT",
  "author": "yxynbglass",
  "homepage": "https://github.com/yxyusage/dsh-work-crew#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yxyusage/dsh-work-crew.git"
  },
  "bugs": {
    "url": "https://github.com/yxyusage/dsh-work-crew/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "multi-agent",
    "orchestration",
    "task-board",
    "cdp",
    "desktop-automation"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
